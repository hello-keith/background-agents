# =============================================================================
# Surface Production Terraform Variables
# =============================================================================
# Copy this file to terraform.tfvars and fill in the values.
# Never commit terraform.tfvars to source control.

# =============================================================================
# Cloudflare
# =============================================================================

cloudflare_api_token        = ""
cloudflare_account_id       = ""
cloudflare_worker_subdomain = ""

# Optional, only needed for custom domains.
# cloudflare_zone_id = ""

# =============================================================================
# Modal
# =============================================================================

modal_token_id                = ""
modal_token_secret            = ""
modal_workspace               = ""
modal_environment             = "main"
modal_environment_web_suffix  = ""
modal_api_secret              = ""

# =============================================================================
# GitHub OAuth And GitHub App
# =============================================================================

github_client_id     = ""
github_client_secret = ""

github_app_id = ""
github_app_private_key = <<-EOF
-----BEGIN PRIVATE KEY-----
... your private key here ...
-----END PRIVATE KEY-----
EOF
github_app_installation_id = ""

enable_github_bot     = false
github_webhook_secret = ""
github_bot_username   = ""

# =============================================================================
# Optional Google Login
# =============================================================================

google_client_id     = ""
google_client_secret = ""

# =============================================================================
# Optional Slack Bot
# =============================================================================

enable_slack_bot    = false
slack_bot_token     = ""
slack_signing_secret = ""

# =============================================================================
# Optional Linear Agent
# =============================================================================

enable_linear_bot     = false
linear_client_id      = ""
linear_client_secret  = ""
linear_webhook_secret = ""
linear_api_key        = ""

# =============================================================================
# API Keys And Secrets
# =============================================================================

anthropic_api_key            = ""
token_encryption_key         = ""
repo_secrets_encryption_key  = ""
internal_callback_secret     = ""
nextauth_secret              = ""

# =============================================================================
# App Configuration
# =============================================================================

deployment_name = ""
project_root    = "../../../"

# app_name = "Surface"
# app_short_name = "Surface"
# app_icon_url = ""

# Optional R2 media bucket override. Leave empty to let Terraform manage
# open-inspect-media-<deployment_name>. Set only for a pre-created private bucket,
# and import that bucket into state before apply so Terraform does not recreate it:
# terraform import cloudflare_r2_bucket.media <account_id>/<bucket_name>
# Do not rename a bucket with stored media unless you are intentionally migrating
# or importing replacement state.
# r2_media_bucket_name = ""
# r2_media_location = "ENAM"

# =============================================================================
# Initial Deployment Flags
# =============================================================================
# For first-time deployment, set both to false. After the first successful
# deployment, set both to true and apply again.

enable_durable_object_bindings = false
enable_service_bindings        = false

# Optional Durable Object migration overrides for existing deployments.
# control_plane_migration_tag = "v1"
# control_plane_migration_old_tag = null
# control_plane_new_sqlite_classes = []

# =============================================================================
# Access Control
# =============================================================================
# Set at least one allowlist unless unsafe_allow_all_users is intentionally true.

allowed_users         = ""
allowed_email_domains = ""
allowed_emails        = ""
unsafe_allow_all_users = false
